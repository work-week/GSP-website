{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "gsp-website",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-29",
	"compatibility_flags": [
		"nodejs_als"
	],
	// Keep the variables set in the Cloudflare dashboard (see README) on deploy.
	"keep_vars": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
